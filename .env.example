# ── Image + secrets (real values live in the gitignored .env; never commit them) ───────────────
# Registry prefix for the pushable image (matches the producer). e.g. maxc2018/ -> maxc2018/shuffull-api
DOCKER_REGISTRY=maxc2018/
# SQL Server sa password: the db container + the api's connection string both read this.
DB_SA_PASSWORD=ChangeMe!StrongPassword1
# JWT signing key (>= 32 chars). The committed appsettings.json holds a PUBLIC dummy — set a real,
# random secret here for any internet-facing deploy, or anyone can forge auth tokens.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Shared secret the producer sends as X-Import-Key. Must match the producer's SiteExport/ShuffullSite
# ImportKey (in the producer's .env.production). Empty => producer ingestion + replacement queue rejected.
SHUFFULL_IMPORT_KEY=replace-with-a-shared-import-key

# Shuffull generated-folder host paths (bind-mounted into the site container).
# Each is its own dedicated folder so it can live anywhere, including a separate
# folder per directory on TrueNAS (e.g. /mnt/tank/shuffull/music). If a var is
# unset, docker-compose falls back to a local ./data/* directory.
SHUFFULL_MUSIC_DIR=./data/music
SHUFFULL_IMPORT_DIR=./data/imports
SHUFFULL_FAILED_IMPORT_DIR=./data/failed_imports
SHUFFULL_MANUAL_IMPORT_DIR=./data/manual_imports
SHUFFULL_AI_RESPONSES_DIR=./data/ai_responses
SHUFFULL_ALBUM_ART_DIR=./data/album_art
SHUFFULL_GENRES_DIR=./data/genres
# Database files (SQL Server), on the pool alongside the media so one snapshot backs up both — same as the
# funnel's db folder. On TrueNAS this folder must be chown'd 10001:0 (the mssql user) or SQL can't write it.
SHUFFULL_DB_DIR=./data/db

# Shared song-handoff queue. This MUST point at the SAME host folder the producer
# exports songs to. The producer writes mp3+json here; Shuffull
# reads them, moves the mp3 into SHUFFULL_IMPORT_DIR, and deletes the json
# (read-write access required).
SHUFFULL_EXTERNAL_IMPORT_DIR=./data/external_imports

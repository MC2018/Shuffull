# ── Image + secrets (real values live in the gitignored .env; never commit them) ───────────────
# Registry prefix for the pushable image — your Docker Hub user or GHCR path (e.g. <user>/ or
# ghcr.io/<user>/). gen-truenas-compose.sh reads it to render the pull image name; build-and-push.sh
# takes it as its first argument. Fill in YOUR registry (don't commit it to .env.example).
DOCKER_REGISTRY=
# Postgres superuser password: the db container (POSTGRES_PASSWORD) + the api's connection string both
# read this. (Was the SQL Server sa password; Postgres has no complexity rules, so any value works.)
DB_SA_PASSWORD=ChangeMe!StrongPassword1
# Postgres role name (POSTGRES_USER + connection string Username). Defaults to "postgres" if unset.
DB_USER=postgres
# JWT signing key (>= 32 chars). The committed appsettings.json holds a PUBLIC dummy — set a real,
# random secret here for any internet-facing deploy, or anyone can forge auth tokens.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Shared secret the producer sends as X-Import-Key. Must match the producer's SiteExport/ShuffullSite
# ImportKey (in the producer's .env.production). Empty => producer ingestion + replacement queue rejected.
SHUFFULL_IMPORT_KEY=replace-with-a-shared-import-key

# Shuffull generated-folder host paths (bind-mounted into the site container).
# Each is its own dedicated folder so it can live anywhere, including a separate
# folder per directory on TrueNAS (e.g. /mnt/tank/shuffull/music). If a var is
# unset, docker-compose falls back to a local ./data/* directory.
SHUFFULL_MUSIC_DIR=./data/music
SHUFFULL_IMPORT_DIR=./data/imports
SHUFFULL_FAILED_IMPORT_DIR=./data/failed_imports
SHUFFULL_MANUAL_IMPORT_DIR=./data/manual_imports
SHUFFULL_AI_RESPONSES_DIR=./data/ai_responses
SHUFFULL_ALBUM_ART_DIR=./data/album_art
SHUFFULL_GENRES_DIR=./data/genres
# Database files (PostgreSQL), on the pool alongside the media so one snapshot backs up both — same as the
# funnel's db folder. The postgres image auto-chowns this dir on first start (no manual chown needed, unlike
# mssql), but it MUST be empty initially — Postgres runs initdb, so an old SQL Server data dir won't work.
SHUFFULL_DB_DIR=./data/db

# Shared song-handoff queue. This MUST point at the SAME host folder the producer
# exports songs to. The producer writes mp3+json here; Shuffull
# reads them, moves the mp3 into SHUFFULL_IMPORT_DIR, and deletes the json
# (read-write access required).
SHUFFULL_EXTERNAL_IMPORT_DIR=./data/external_imports

# ── AI / re-tagging ──────────────────────────────────────────────────────────
# The producer (funnel) tags songs at import, so the site only needs AI for the RETAG endpoints that the
# audition tier drives: a Keep re-tags with the weak model, a like/curator upgrade with the strong one.
# The committed appsettings.json ships AI disabled — leave AI_ENABLED unset/false and re-tagging simply
# returns "AI is not enabled; cannot enrich songs." (Keeps and like-promotions will fail silently).
AI_ENABLED=false
AI_PLATFORM=openai
OPENAI_API_KEY=
# VALIDATED at startup: must be "chat/completions" or "responses", else the container refuses to boot.
OPENAI_API_ENDPOINT=chat/completions
# Model used for likes / curator upgrades (the quality tier).
OPENAI_STRONG_MODEL=
# Model used for audition Keeps (the budget tier). OPTIONAL — unset falls back to the strong model, so
# Keeps still work but cost the same. Set it to actually realize the tiered-retag savings.
OPENAI_WEAK_MODEL=
# NOTE: whatever you set here should also appear in the "AI:ModelStrengths" map in appsettings.json, with
# the weak model ranked BELOW the strong one. That map is what makes a weak-tagged song count as stale and
# therefore upgradeable on a later like; an unregistered strong model marks nothing stale (fail-safe).

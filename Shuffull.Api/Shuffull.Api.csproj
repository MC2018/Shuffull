<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS / validation pipeline (handlers + validators live in Shuffull.Core). -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- SQL Server provider for the shared ShuffullContext (migrations stay in Shuffull.Site). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="7.0.3" />
    <!-- JWT auth. 6.35.0 is the patched tail of the 6.x line (wire-compatible with the 6.21.0
         Shuffull.Site resolves transitively) and clears the NU1902 advisory on 6.21.0. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.35.0" />
    <PackageReference Include="Nut.Results" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shuffull.Core\Shuffull.Core.csproj" />
  </ItemGroup>

</Project>

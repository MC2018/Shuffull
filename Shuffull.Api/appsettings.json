{
  "ConnectionStrings": {
    "Shuffull": "Host=localhost;Port=5432;Database=Shuffull;Username=postgres;Password=Password!"
  },
  "Shuffull": {
    "Files": {
      "MusicRootDirectory": "/root/shuffull_data/music",
      "SongImportDirectory": "/root/shuffull_data/imports",
      "ExternalSongImportDirectory": "/root/shuffull_data/external_imports",
      "FailedImportDirectory": "/root/shuffull_data/failed_imports",
      "ManualSongImportDirectory": "/root/shuffull_data/manual_imports",
      "SavedAiResponsesDirectory": "/root/shuffull_data/ai_responses",
      "GenresFile": "/root/shuffull_data/genres.json",
      "AlbumArtDirectory": "/root/album_art"
    },
    "Import": {
      // Shared secret for the producer's HTTP ingestion endpoint (POST /api/v1/song-imports).
      // Empty here; set the real value via the Shuffull__Import__Key env var (.env / docker-compose).
      // Empty means producer ingestion is rejected (Unauthorized).
      "Key": ""
    }
  },
  "AI": {
    "Enabled": false,
    "Platform": "",
    // Relative model strengths (bigger = stronger), provider-neutral. Drives which songs the re-tag endpoint
    // treats as stale: a song is stale when its TagModel is weaker than the current strong model. Null/unknown
    // models count as 0; an unregistered current strong model marks nothing stale (fail-safe). Gaps left for
    // inserting future intermediate models.
    "ModelStrengths": {
      // Ordering is what matters, not the absolute numbers; gaps are left for inserting future models.
      // KEEP THIS MAP IN SYNC with the other one (Shuffull.Api <-> YoutubeFunnel.Downloader).
      "gpt-5.4-nano": 5,
      "gpt-5.4-mini": 10,
      // Muse sits below the strong model on purpose, so a Muse-tagged song reads stale and a like still
      // upgrades it -- that upgrade path is the point of the tier ladder. Raise it only if Muse's tags prove
      // genuinely comparable, since doing so stops re-tagging them on like.
      // Same checkpoint, different billing SKU: the contributor tier is heavily discounted in exchange for
      // Meta training on the prompts/completions, and it is a DISTINCT model id. Both are listed so a switch
      // between them never drops a song to strength 0 — which would silently disable staleness and let the
      // funnel's cache gate accept anything.
      "muse-spark-1.2": 20,
      "muse-spark-1.2-contributor": 20,
      "gpt-5.5": 30,
      "gpt-5.6-terra": 40
    },
    // Which provider serves each tier. Values name sibling sections below ("OpenAI", "Meta").
    // Both default to OpenAI, so leaving this alone keeps today's behaviour exactly.
    "Tiers": {
      "Weak": "OpenAI",
      "Strong": "OpenAI"
    },
    // Meta's Model API. It speaks the OpenAI chat/completions shape, strict JSON-schema structured outputs
    // included, so it needs no code of its own -- only this section and a BaseUrl.
    // Empty ApiKey here on purpose: set the real value via the AI__Meta__ApiKey env var, never in this file.
    // A blank key is fine while no tier points at Meta; the app refuses to start if one does.
    "Meta": {
      "ApiKey": "",
      "BaseUrl": "https://api.meta.ai/v1",
      "WeakModelName": "muse-spark-1.2-contributor",
      "StrongModelName": "muse-spark-1.2-contributor",
      "ApiEndpoint": "chat/completions"
    }
  },
  "OpenAI": {
    "Enabled": false,
    "ApiKey": "key",
    "ModelName": "gpt-4-0125-preview",
    "InstructionFile": "ai_instruction.txt"
  },
  "Jwt": {
    // Must be at least 256 bits (32 characters). Keep this value identical across all
    // environments so tokens issued by one server validate against the others.
    "Secret": "VeryLongPasswordVeryLongPassword!"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

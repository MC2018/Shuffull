<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Commands\Songs\GetUser\**" />
    <Compile Remove="music\**" />
    <Content Remove="Commands\Songs\GetUser\**" />
    <Content Remove="music\**" />
    <EmbeddedResource Remove="Commands\Songs\GetUser\**" />
    <EmbeddedResource Remove="music\**" />
    <None Remove="Commands\Songs\GetUser\**" />
    <None Remove="music\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Migrations\20231104053837_TagReform.cs" />
    <Compile Remove="Migrations\20231104053837_TagReform.Designer.cs" />
    <Compile Remove="Migrations\20250608125243_IdsToUlid.cs" />
    <Compile Remove="Migrations\20250608125243_IdsToUlid.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="Azure.Identity" Version="1.13.2" />
    <PackageReference Include="Google.Apis.YouTube.v3" Version="1.69.0.3764" />
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="7.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="7.0.3" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="5.2.8" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.3.8" />
    <PackageReference Include="Nut.Results" Version="2.1.1" />
    <PackageReference Include="Nut.Results.FluentAssertions" Version="2.1.1" />
    <PackageReference Include="OpenAI" Version="2.2.0-beta.4" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="Ulid" Version="1.3.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shuffull.Shared\Shuffull.Shared.csproj" />
    <ProjectReference Include="..\Shuffull.Metadata\Shuffull.Metadata.csproj" />
    <ProjectReference Include="..\Shuffull.Core\Shuffull.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CQRS / validation pipeline (mirrors the Sociallite backend). Kept on net8.0-compatible
         versions; the data-access + validation infrastructure itself lives in Shuffull.Core. -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.Production.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Deploy.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.Staging.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>

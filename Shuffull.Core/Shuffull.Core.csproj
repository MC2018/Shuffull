<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS / validation pipeline. Versions chosen to stay on net8.0 + EF Core 8 (matching
         Shuffull.Api) rather than the net9/EF9 stack the Sociallite reference uses. -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- Argon2 for the client and server password hashes (Tools/Hasher, Authentication/ServerPasswordHash) and
         ULIDs for ids (Tools/IdGenerator). Same versions Shuffull.Shared used, so the stored outputs don't change. -->
    <PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.0" />
    <PackageReference Include="Ulid" Version="1.3.4" />
    <!-- Base DbContext only: Core stays decoupled from the concrete ShuffullContext (which lives in
         Shuffull.Core.Persistence) so the repository/UoW work over any EF Core context. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.28" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.28" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nut.Results" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The entity model uses the producer-shared enums (Shuffull.Metadata.Enums). Metadata doesn't
         reference Core, so there is no cycle. -->
    <ProjectReference Include="..\Shuffull.Metadata\Shuffull.Metadata.csproj" />
  </ItemGroup>

</Project>

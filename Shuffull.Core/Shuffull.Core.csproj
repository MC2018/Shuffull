<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- CQRS / validation pipeline. Versions chosen to stay on net8.0 + EF Core 7 (matching
         Shuffull.Site) rather than the net9/EF9 stack the Sociallite reference uses. -->
    <PackageReference Include="MediatR" Version="12.4.1" />
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <!-- Base DbContext only: Core stays decoupled from the concrete ShuffullContext (which still
         lives in Shuffull.Site) so the repository/UoW work over any EF Core context. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="7.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="7.0.3" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="7.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Nut.Results" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The migrated entity model uses shared enums (Shuffull.Shared.Enums) and the funnel-shared
         enums (Shuffull.Metadata.Enums), so Core references those libraries. Neither references Core,
         so there is no cycle. -->
    <ProjectReference Include="..\Shuffull.Shared\Shuffull.Shared.csproj" />
    <ProjectReference Include="..\Shuffull.Metadata\Shuffull.Metadata.csproj" />
  </ItemGroup>

</Project>
